# Local PostgreSQL for docker compose. Replace the example password before use.
POSTGRES_DB=nabaat
POSTGRES_USER=nabaat
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://nabaat:replace-with-a-local-password@db:5432/nabaat

# API runtime
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://kareemzeki-boop.github.io

# GitHub Actions repository variable (not a secret): public API origin, e.g. https://api.example.com
NABAAT_API_URL=
